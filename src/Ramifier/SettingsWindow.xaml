<Window x:Class="Ramifier.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <StackPanel Margin="24">

        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>

        <!-- Persistent Disks -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Persistent Disks" FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Recreate RAM disks automatically on app startup"
                               FontSize="11" Foreground="{StaticResource TextDimBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="PersistentCheck" Grid.Column="1"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Start on Boot -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Start on Boot" FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Launch Ramifier when Windows starts"
                               FontSize="11" Foreground="{StaticResource TextDimBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="StartupCheck" Grid.Column="1"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Version -->
        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                   Margin="0,0,0,16"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                    Click="Cancel_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Save" Style="{StaticResource AccentButton}"
                    Click="Save_Click" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
