<Window x:Class="Ramifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ramifier.ViewModels"
        Title="Ramifier" Height="560" Width="700"
        MinHeight="480" MinWidth="580"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel Margin="24">

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Settings" Style="{StaticResource GhostButton}"
                    Command="{Binding SettingsCommand}" VerticalAlignment="Center"/>
            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                       Text="Ramifier" VerticalAlignment="Center"/>
            <TextBlock Text="RAM Disk Manager" FontSize="13"
                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </DockPanel>

        <!-- ImDisk Warning + Install -->
        <Border DockPanel.Dock="Top" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                BorderBrush="#B91C1C" BorderThickness="1"
                Background="#1C0A0A"
                Visibility="{Binding IsImDiskInstalled, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Install"
                        Command="{Binding InstallImDiskCommand}"
                        Style="{StaticResource AccentButton}"
                        Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="ImDisk Toolkit is required but not installed."
                           Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="13"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Update Banner -->
        <Border DockPanel.Dock="Top" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                BorderBrush="#1D4ED8" BorderThickness="1"
                Background="#0C1A3D"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Margin="10,0,0,0"
                        Command="{Binding DismissUpdateCommand}"
                        VerticalAlignment="Center" Cursor="Hand"
                        Foreground="{StaticResource TextDimBrush}" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button DockPanel.Dock="Right" Content="Download" Margin="14,0,0,0"
                        Command="{Binding UpdateCommand}"
                        Style="{StaticResource GhostButton}"
                        VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13">
                    <Run Text="Update available:" Foreground="#93C5FD"/>
                    <Run Text="{Binding UpdateVersion, Mode=OneWay}" Foreground="#93C5FD" FontWeight="SemiBold"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Status Bar -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextDimBrush}"
                   FontSize="11" Margin="0,8,0,0"/>

        <!-- RAM Info -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                CornerRadius="8" Padding="14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="System Memory" FontSize="12" FontWeight="Medium"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <ProgressBar Value="{Binding RamUsagePercent, Mode=OneWay}"
                                 Minimum="0" Maximum="100" Margin="0,8,0,0"
                                 Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0">
                    <Run Text="{Binding AvailableRamDisplay, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}"/>
                    <Run Text=" free / " Foreground="{StaticResource TextDimBrush}"/>
                    <Run Text="{Binding TotalRamDisplay, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Main content: left create, right active disks -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Create Section -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8" Padding="18"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Create RAM Disk" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                    <Button DockPanel.Dock="Bottom" Content="Create" Style="{StaticResource AccentButton}"
                            Command="{Binding CreateCommand}" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="Drive Letter"/>
                        <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  ItemsSource="{Binding DriveLetters}"
                                  SelectedItem="{Binding SelectedDriveLetter}"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Size" Margin="0,2,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="0"
                                 Text="{Binding SelectedSizeValue, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center"/>

                        <Label Grid.Row="3" Grid.Column="2" Content="Unit" Margin="0,2,0,0"/>
                        <ComboBox Grid.Row="4" Grid.Column="2"
                                  ItemsSource="{Binding SizeUnits}"
                                  SelectedItem="{Binding SelectedSizeUnit}"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="File System"/>
                        <ComboBox Grid.Row="7" Grid.Column="0"
                                  ItemsSource="{Binding FileSystems}"
                                  SelectedItem="{Binding SelectedFileSystem}"/>

                        <Label Grid.Row="6" Grid.Column="2" Content="Label"/>
                        <TextBox Grid.Row="7" Grid.Column="2"
                                 Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Right: Active Disks -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8" Padding="18"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Active Disks" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Remove All" Style="{StaticResource GhostButton}"
                                Command="{Binding RemoveAllCommand}"
                                HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Grid>
                        <TextBlock Text="No active RAM disks" Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                                   Visibility="{Binding ActiveDisks.Count, Converter={StaticResource ZeroToVis}}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ActiveDisks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgBrush}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,8"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{StaticResource HoverBrush}"
                                                        CornerRadius="6" Width="40" Height="40"
                                                        VerticalAlignment="Center" Margin="0,0,12,0"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding DriveLetter}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13"
                                                               FontWeight="Medium" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding DriveLetter, Mode=OneWay}"/>
                                                        <Run Text=":\"/>
                                                        <Run Text=" — " Foreground="{StaticResource TextDimBrush}"/>
                                                        <Run Text="{Binding SizeDisplay, Mode=OneWay}"
                                                             Foreground="{StaticResource TextDimBrush}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding FileSystem, Mode=OneWay}"
                                                             Foreground="{StaticResource TextDimBrush}"/>
                                                    </TextBlock>
                                                    <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}"
                                                                 Minimum="0" Maximum="100" Margin="0,6,0,0"
                                                                 Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0">
                                                        <Run Text="{Binding UsedDisplay, Mode=OneWay}"/>
                                                        <Run Text=" used"/>
                                                        <Run Text="  ·  " Foreground="{StaticResource BorderBrush}"/>
                                                        <Run Text="{Binding FreeDisplay, Mode=OneWay}"/>
                                                        <Run Text=" free"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="✕"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Center" MinWidth="32" MinHeight="32"
                                                        FontSize="13" Foreground="{StaticResource TextDimBrush}" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="Transparent"
                                                                    CornerRadius="6" Width="32" Height="32"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                                    <Setter Property="Foreground" Value="#FCA5A5"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
